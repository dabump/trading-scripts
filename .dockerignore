# Keep credentials and runtime state out of the build context entirely — anything
# copied in is recoverable from the image, so secrets must never enter it.
# .env* rather than .env: dockerignore patterns are literal and * does not cross a
# slash, so plain ".env" would let .env.local / .env.paper / .env.live into the build
# context and the build-stage layer.
.env*
!.env.example
data/
logs/

.git/
.gitignore
.claude/
archived/
docs/
*.md
# Re-included: the trade review worker reads these three at runtime
# (claude.docs_dir) to ground Claude's analysis of a losing trade.
!docs/strategy.md
!docs/risk.md
!docs/decisions.md
Dockerfile
docker-compose.yml
.dockerignore
