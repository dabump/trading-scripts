# Copy this file to .env and fill in real values. Never commit the populated .env.
# Get these from your Alpaca dashboard (https://app.alpaca.markets) — paper trading keys
# require no identity verification or funding; live trading keys do.

ALPACA_API_KEY=
ALPACA_API_SECRET=

# Paper: https://paper-api.alpaca.markets
# Live:  https://api.alpaca.markets
# Per docs/operations.md, switching this to the live URL is a deliberate decision
# requiring explicit sign-off, not a routine config change.
ALPACA_BASE_URL=https://paper-api.alpaca.markets
